# Copy to .env and fill in real values. Never commit .env.

# Pooled (PgBouncer) Postgres URL -- used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/db?sslmode=require"

# Direct (non-pooled) URL for the same database -- used by Prisma CLI
# migrations (prisma migrate dev / deploy). On Neon: same host without "-pooler".
DIRECT_DATABASE_URL="postgresql://user:password@host.example.com/db?sslmode=require"

# Optional locally. Required on Vercel so Cron can authenticate.
CRON_SECRET=

# DeepSeek (official model ids: deepseek-v4-pro / deepseek-v4-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Leave empty for real mode when DEEPSEEK_API_KEY is set.
# Set to "mock" for offline deterministic tool loops.
AGENT_MODE=

# Clerk authentication. Keep registration restricted with a Clerk allowlist
# during the staged Beta.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Inngest. Leave async delivery disabled until shadow due-user validation is
# complete. Signing/event keys are supplied by the Inngest/Vercel integration.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ASYNC_AGENT_ENABLED=false
ASYNC_AGENT_SHADOW=true

# Sentry is disabled automatically when no DSN is set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
